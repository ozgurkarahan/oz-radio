# =============================================================
# Oz Radio — Environment Configuration Template
# =============================================================
# Copy to .env and fill in values. Do NOT commit .env files.
# =============================================================

# --- Azure AI Speech / AI Services (avatar rendering) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=swedencentral
AZURE_SPEECH_ENDPOINT=https://<your-ai-services-name>.cognitiveservices.azure.com/
AZURE_SPEECH_RESOURCE_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<name>

# --- Azure OpenAI (translation + Q&A) ---
AZURE_OPENAI_ENDPOINT=https://<your-openai-name>.openai.azure.com/
AZURE_OPENAI_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Auth: managed identity (DefaultAzureCredential) or key-based ---
AZURE_USE_MANAGED_IDENTITY=true

# --- LibreOffice: path to soffice binary (for PPTX rendering) ---
# Docker: "soffice" (on PATH)
# Windows: C:\Program Files\LibreOffice\program\soffice.exe
LIBREOFFICE_PATH=soffice

# --- Azure Cosmos DB (presentation persistence) ---
AZURE_COSMOS_ENDPOINT=https://<your-cosmos-name>.documents.azure.com:443/
AZURE_COSMOS_KEY=
AZURE_COSMOS_DATABASE=ai-presenter

# --- Azure Blob Storage (slide images) ---
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<name>;AccountKey=<key>;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER=slide-images

# --- Microsoft Agent Framework (for agent_app.py) ---
# Azure AI Foundry project endpoint (required for agent mode)
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry-project>.cognitiveservices.azure.com/
# Model deployment used by the agent (defaults to gpt-4.1)
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-4.1

# --- Azure AI Search (decks catalog search) ---
AZURE_SEARCH_ENDPOINT=https://<your-search-name>.search.windows.net
# Optional: if empty, DefaultAzureCredential (managed identity) is used.
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=decks

# =============================================================
# Security / exposure model
# =============================================================
# easyauth = trust Azure Container Apps Easy Auth headers (production)
# disabled = local development only: every caller is admin (a WARNING is logged)
AUTH_MODE=disabled
# Entra tenant GUID; the signed-in principal's tid must match (easyauth only)
AUTH_TENANT_ID=
# Comma-separated Entra object ids (oid) allowed as admin; empty => nobody is admin
ALLOWED_OBJECT_IDS=
# Comma-separated origins for CORS + WebSocket Origin check; empty => same-origin only
ALLOWED_ORIGINS=
# CSP frame-ancestors (Teams embedding); empty => built-in Teams/Office default
FRAME_ANCESTORS=
# Allow podcast ingestion from URLs (SSRF-hardened); file uploads are the main path
ENABLE_URL_INGEST=false
# Limits
MAX_VOICE_SESSIONS=2
MAX_VOICE_SESSION_SECONDS=900
DAILY_GENERATION_QUOTA=50
MAX_PENDING_RENDERS=3

# --- Podcast radio version + live listener (see docs/podcast.md) ---
# Anonymous visitors may stream PUBLISHED podcast audio and read its transcript
# (the "Listen" button). Kill switch, default off.
PODCAST_PUBLIC_AUDIO=false
# Listener backchannels ("mm-hmm", "right") in video and radio. Hard kill switch,
# default off; the studio's "Listener reactions" option only works when this is on.
PODCAST_REACTIONS=false
# How the non-speaking host looks: auto | idle_loop | procedural | still
PODCAST_LISTENER_MODE=auto
PODCAST_LISTENER_TIMEOUT_SEC=900
# ffmpeg composes at a time / batch avatar jobs in flight / batch job creations per minute
MAX_CONCURRENT_COMPOSES=1
MAX_ACTIVE_BATCH_JOBS=8
SPEECH_BATCH_CREATE_PER_MIN=2
# Optional radio TTS tuning (defaults shown)
# PODCAST_TTS_PARALLEL=4
# PODCAST_TTS_OUTPUT_FORMAT=riff-24khz-16bit-mono-pcm

# --- Public live-avatar demo (anonymous, narration-only; see docs/live-demo.md) ---
# Kill switch (default off). Anonymous visitors can only narrate decks an admin
# marked "Live demo"; worst-case avatar minutes/day =
# DEMO_DAILY_SESSIONS x DEMO_SESSION_SECONDS / 60.
PUBLIC_DEMO_ENABLED=false
DEMO_MAX_CONCURRENT=1
DEMO_SESSION_SECONDS=180
DEMO_DAILY_SESSIONS=20
DEMO_DAILY_SESSIONS_PER_IP=3
# Narrations per session; 0/empty => 2 x slide count (hard max 40)
DEMO_MAX_SPEAKS=0
# Voice questions in the public demo ("Raise hand"); off by default. When on,
# demo sessions last DEMO_QA_SESSION_SECONDS instead of DEMO_SESSION_SECONDS.
DEMO_QA_ENABLED=false
DEMO_QA_MAX_QUESTIONS=2
DEMO_QA_SESSION_SECONDS=300
DEMO_QA_DAILY_MAX=40
DEMO_QA_DAILY_PER_IP=6

# --- Cookieless usage telemetry (ships disabled; see infra/README.md) ---
# Six allow-listed browser events to Application Insights. Keep it off until the
# privacy page lists the events. Needs a connection string with a GUID key and an
# https ingestion endpoint; GPC / Do Not Track visitors never send anything.
TELEMETRY_ENABLED=false
TELEMETRY_CONNECTION_STRING=

# --- Custom avatars (optional) ---
# JSON array; `character` is the server-only Speech talkingAvatarCharacter and is
# never returned by the API. `thumbnail` is a file name under static/avatars/.
# kind: "photo" (default, vasa-1 photo avatar) or "video".
# CUSTOM_AVATARS_JSON=[{"id":"photo_female","display_name":"Photo Female","character":"<speech-character-name>","gender":"female","thumbnail":"photo_female.png","default":true},{"id":"photo_male","display_name":"Photo Male","character":"<speech-character-name>","gender":"male","thumbnail":"photo_male.png"}]
CUSTOM_AVATARS_JSON=
# true => offer only the custom avatars above (stock ids alias to them)
HIDE_STOCK_AVATARS=false
