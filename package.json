{
  "name": "oz-radio",
  "version": "1.0.0",
  "private": true,
  "description": "Oz Radio — AI avatars that present, narrate and podcast your decks. Root package holds the Playwright UI tests.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test:ui": "playwright test --project=chromium",
    "test:ui:playlists": "playwright test tests/playlists.spec.ts --project=chromium",
    "test:regression": "playwright test tests/regression.spec.ts tests/podcast-listen.spec.ts tests/podcast-studio.spec.ts --project=chromium"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozgurkarahan/oz-radio.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ozgurkarahan/oz-radio/issues"
  },
  "homepage": "https://github.com/ozgurkarahan/oz-radio#readme",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.2"
  }
}
