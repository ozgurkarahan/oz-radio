{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "backendImageName": {
      "value": "${SERVICE_BACKEND_IMAGE_NAME=}"
    },
    "authClientId": {
      "value": "${AUTH_CLIENT_ID=}"
    },
    "authTenantId": {
      "value": "${AUTH_TENANT_ID=}"
    },
    "authClientSecret": {
      "value": "${AUTH_CLIENT_SECRET=}"
    },
    "authExtraClientApps": {
      "value": "${AUTH_EXTRA_CLIENT_APPS=}"
    },
    "allowedObjectIds": {
      "value": "${ALLOWED_OBJECT_IDS=}"
    },
    "allowedOrigins": {
      "value": "${ALLOWED_ORIGINS=}"
    },
    "customAvatarsJson": {
      "value": "${CUSTOM_AVATARS_JSON=}"
    },
    "hideStockAvatars": {
      "value": "${HIDE_STOCK_AVATARS=false}"
    },
    "enableUrlIngest": {
      "value": "${ENABLE_URL_INGEST=false}"
    },
    "maxVoiceSessions": {
      "value": "${MAX_VOICE_SESSIONS=2}"
    },
    "maxVoiceSessionSeconds": {
      "value": "${MAX_VOICE_SESSION_SECONDS=900}"
    },
    "dailyGenerationQuota": {
      "value": "${DAILY_GENERATION_QUOTA=50}"
    },
    "maxPendingRenders": {
      "value": "${MAX_PENDING_RENDERS=3}"
    },
    "maxConcurrentComposes": {
      "value": "${MAX_CONCURRENT_COMPOSES=1}"
    },
    "maxActiveBatchJobs": {
      "value": "${MAX_ACTIVE_BATCH_JOBS=8}"
    },
    "speechBatchCreatePerMin": {
      "value": "${SPEECH_BATCH_CREATE_PER_MIN=2}"
    },
    "podcastPublicAudio": {
      "value": "${PODCAST_PUBLIC_AUDIO=false}"
    },
    "podcastReactions": {
      "value": "${PODCAST_REACTIONS=false}"
    },
    "podcastListenerMode": {
      "value": "${PODCAST_LISTENER_MODE=auto}"
    },
    "podcastListenerTimeoutSec": {
      "value": "${PODCAST_LISTENER_TIMEOUT_SEC=900}"
    },
    "publicDemoEnabled": {
      "value": "${PUBLIC_DEMO_ENABLED=false}"
    },
    "demoMaxConcurrent": {
      "value": "${DEMO_MAX_CONCURRENT=1}"
    },
    "demoSessionSeconds": {
      "value": "${DEMO_SESSION_SECONDS=180}"
    },
    "demoDailySessions": {
      "value": "${DEMO_DAILY_SESSIONS=20}"
    },
    "demoDailySessionsPerIp": {
      "value": "${DEMO_DAILY_SESSIONS_PER_IP=3}"
    },
    "demoDailyMinutes": {
      "value": "${DEMO_DAILY_MINUTES=60}"
    },
    "demoMaxSpeaks": {
      "value": "${DEMO_MAX_SPEAKS=0}"
    },
    "demoQuotaExemptIps": {
      "value": "${DEMO_QUOTA_EXEMPT_IPS=}"
    },
    "demoQaEnabled": {
      "value": "${DEMO_QA_ENABLED=false}"
    },
    "demoQaMaxQuestions": {
      "value": "${DEMO_QA_MAX_QUESTIONS=2}"
    },
    "demoQaSessionSeconds": {
      "value": "${DEMO_QA_SESSION_SECONDS=300}"
    },
    "demoQaDailyMax": {
      "value": "${DEMO_QA_DAILY_MAX=40}"
    },
    "demoQaDailyPerIp": {
      "value": "${DEMO_QA_DAILY_PER_IP=6}"
    },
    "useExternalAiServices": {
      "value": "${USE_EXTERNAL_AI_SERVICES=false}"
    },
    "externalAiServicesEndpoint": {
      "value": "${EXTERNAL_AI_SERVICES_ENDPOINT=}"
    },
    "externalAiServicesRegion": {
      "value": "${EXTERNAL_AI_SERVICES_REGION=}"
    },
    "externalAiServicesResourceId": {
      "value": "${EXTERNAL_AI_SERVICES_RESOURCE_ID=}"
    },
    "assignExternalAiServicesRoles": {
      "value": "${ASSIGN_EXTERNAL_AI_SERVICES_ROLES=true}"
    },
    "enableBlobAccessLogs": {
      "value": "${ENABLE_BLOB_ACCESS_LOGS=true}"
    },
    "extraTagsJson": {
      "value": "${EXTRA_TAGS_JSON=}"
    },
    "budgetAmount": {
      "value": "${BUDGET_AMOUNT=50}"
    },
    "budgetContactEmails": {
      "value": "${BUDGET_CONTACT_EMAILS=}"
    },
    "budgetStartDate": {
      "value": "${BUDGET_START_DATE=}"
    }
  }
}
